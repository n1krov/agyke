{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agyke.local/schemas/board.schema.json",
  "title": "Agyke Task Board Schema",
  "description": "Esquema JSON estricto para el tablero de tareas operativo del agente de IA en Agyke",
  "type": "object",
  "required": ["version", "project", "last_updated", "active_sprint", "summary", "tasks"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "project": {
      "type": "string"
    },
    "last_updated": {
      "type": "string"
    },
    "active_sprint": {
      "type": "string"
    },
    "summary": {
      "type": "object",
      "required": ["total", "done", "in_progress", "pending", "backlog"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 },
        "in_progress": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "backlog": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "domain",
          "status",
          "priority",
          "spec_reference",
          "dependencies",
          "acceptance_criteria",
          "files_to_touch"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(CORE|BOT|WEB|AUTH|MULTI|UI|DEVOPS)-[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "domain": {
            "type": "string",
            "enum": ["core", "bot", "web", "multimodal", "auth", "ui_ux", "devops"]
          },
          "status": {
            "type": "string",
            "enum": ["pending", "in_progress", "testing", "done", "backlog", "blocked"]
          },
          "priority": {
            "type": "string",
            "enum": ["p0", "p1", "p2", "p3"]
          },
          "spec_reference": {
            "type": "string"
          },
          "dependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "acceptance_criteria": {
            "type": "array",
            "items": { "type": "string" }
          },
          "files_to_touch": {
            "type": "array",
            "items": { "type": "string" }
          },
          "completed_at": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
